# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/billbox?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend URL (For CORS)
CLIENT_URL=http://localhost:5173

# Email (Nodemailer for Warranty Reminders)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@billbox.com

# File Storage (Local Disk or Cloud Object Storage)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Cloud Storage Adapter (Optional - Set to 's3' or 'r2' to enable cloud object storage)
STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_key
# AWS_BUCKET_NAME=your_bucket_name
# AWS_REGION=us-east-1
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_URL=https://cdn.billbox.app

# Google Gemini API Key (For AI OCR & Line Item Extraction)
GEMINI_API_KEY=your_gemini_api_key_here
